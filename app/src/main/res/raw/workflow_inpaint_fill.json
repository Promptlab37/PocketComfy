{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-Fill-Dev_FP8.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Flux Fill" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp16.safetensors",
      "type": "flux",
      "device": "default"
    },
    "_meta": { "title": "Textové enkodéry" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.sft" },
    "_meta": { "title": "VAE" }
  },
  "4": {
    "class_type": "Power Lora Loader (rgthree)",
    "inputs": {
      "model": ["1", 0],
      "clip": ["2", 0],
      "lora_1": { "on": true, "lora": "FLUX.1-Turbo-Alpha.safetensors", "strength": 1.0 }
    },
    "_meta": { "title": "Turbo LoRA" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Fotka" }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Maska štětce (bílá = domalovat)" }
  },
  "12": {
    "class_type": "ImageToMask",
    "inputs": { "image": ["11", 0], "channel": "red" },
    "_meta": { "title": "Maska z obrázku" }
  },
  "20": {
    "class_type": "InpaintCropImproved",
    "inputs": {
      "image": ["10", 0],
      "mask": ["12", 0],
      "downscale_algorithm": "bilinear",
      "upscale_algorithm": "bicubic",
      "preresize": false,
      "preresize_mode": "ensure minimum resolution",
      "preresize_min_width": 1024,
      "preresize_min_height": 1024,
      "preresize_max_width": 16384,
      "preresize_max_height": 16384,
      "mask_fill_holes": true,
      "mask_expand_pixels": 0,
      "mask_invert": false,
      "mask_blend_pixels": 24,
      "mask_hipass_filter": 0.1,
      "extend_for_outpainting": false,
      "extend_up_factor": 1.0,
      "extend_down_factor": 1.0,
      "extend_left_factor": 1.0,
      "extend_right_factor": 1.0,
      "context_from_mask_extend_factor": 1.5,
      "output_resize_to_target_size": true,
      "output_target_width": 1024,
      "output_target_height": 1024,
      "output_padding": "32",
      "device_mode": "cpu (compatible)"
    },
    "_meta": { "title": "Výřez kolem masky" }
  },
  "30": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["4", 1], "text": "" },
    "_meta": { "title": "Zadání" }
  },
  "31": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["30", 0], "guidance": 30.0 },
    "_meta": { "title": "Vedení Fluxu" }
  },
  "32": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["30", 0] },
    "_meta": { "title": "Prázdný negativ" }
  },
  "33": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["31", 0],
      "negative": ["32", 0],
      "vae": ["3", 0],
      "pixels": ["20", 1],
      "mask": ["20", 2],
      "noise_mask": true
    },
    "_meta": { "title": "Inpaint podmínky" }
  },
  "45": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["33", 0],
      "negative": ["33", 1],
      "latent_image": ["33", 2],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "sgm_uniform",
      "denoise": 1.0
    },
    "_meta": { "title": "Vzorkování" }
  },
  "50": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["45", 0], "vae": ["3", 0] },
    "_meta": { "title": "Dekódování" }
  },
  "51": {
    "class_type": "InpaintStitchImproved",
    "inputs": { "stitcher": ["20", 0], "inpainted_image": ["50", 0] },
    "_meta": { "title": "Vlepení zpět do fotky" }
  },
  "60": {
    "class_type": "SaveImage",
    "inputs": { "images": ["51", 0], "filename_prefix": "PocketInpaint" },
    "_meta": { "title": "Uložení" }
  }
}
