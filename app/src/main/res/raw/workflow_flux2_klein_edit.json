{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux-2-klein-9b.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "FLUX.2 Klein 9B" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_8b_fp8mixed.safetensors", "type": "flux2", "device": "default" },
    "_meta": { "title": "Textovy enkoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "full_encoder_small_decoder.safetensors" },
    "_meta": { "title": "VAE pro editaci" }
  },

  "20": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Upravovana fotka" }
  },
  "21": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": ["20", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 1
    },
    "_meta": { "title": "Srovnat na 1 MP" }
  },
  "22": {
    "class_type": "GetImageSize",
    "inputs": { "image": ["21", 0] },
    "_meta": { "title": "Rozmery predlohy" }
  },
  "23": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["21", 0], "vae": ["3", 0] },
    "_meta": { "title": "Predloha do latentu" }
  },

  "30": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "" },
    "_meta": { "title": "Co zmenit" }
  },
  "32": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["30", 0] },
    "_meta": { "title": "Prazdny negativ" }
  },
  "33": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["30", 0], "latent": ["23", 0] },
    "_meta": { "title": "Predloha k zadani" }
  },
  "34": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["32", 0], "latent": ["23", 0] },
    "_meta": { "title": "Predloha k negativu" }
  },

  "10": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": ["22", 0], "height": ["22", 1], "batch_size": 1 },
    "_meta": { "title": "Platno podle predlohy" }
  },
  "40": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 4, "width": ["22", 0], "height": ["22", 1] },
    "_meta": { "title": "Plan kroku" }
  },
  "41": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" },
    "_meta": { "title": "Vzorkovac" }
  },
  "42": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 },
    "_meta": { "title": "Seed" }
  },
  "43": {
    "class_type": "CFGGuider",
    "inputs": { "model": ["1", 0], "positive": ["33", 0], "negative": ["34", 0], "cfg": 1.0 },
    "_meta": { "title": "Vedeni" }
  },
  "44": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["42", 0],
      "guider": ["43", 0],
      "sampler": ["41", 0],
      "sigmas": ["40", 0],
      "latent_image": ["10", 0]
    },
    "_meta": { "title": "Vzorkovani" }
  },
  "50": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["44", 0], "vae": ["3", 0] },
    "_meta": { "title": "Dekodovani" }
  },
  "60": {
    "class_type": "SaveImage",
    "inputs": { "images": ["50", 0], "filename_prefix": "PocketKleinEdit" },
    "_meta": { "title": "Ulozit" }
  }
}
